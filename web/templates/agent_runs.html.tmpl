{{define "content"}}<section class="agent-runs">
  <h1>エージェント実行トレース</h1>
  <p class="description">Agent-run loop の各実行（PRD §27/§50）。ツール呼び出しの内容は <a href="/ai">AIダッシュボード</a> から確認できます。</p>

  <div class="table-card">
    <table>
      <thead><tr><th>Agent</th><th>Prompt</th><th>状態</th><th>ターン数</th><th>所要時間</th><th>開始</th><th></th></tr></thead>
      <tbody>
        {{range .Runs}}<tr>
          <td>{{.Agent}}</td>
          <td>{{.PromptName}} {{.PromptVersion}}</td>
          <td><span class="badge">{{.Status}}</span></td>
          <td>{{.Turns}}</td>
          <td>{{if .EndedAt.IsZero}}—{{else}}{{.Duration}}{{end}}</td>
          <td>{{.StartedAt.Format "2006-01-02 15:04:05"}}</td>
          <td><a href="/ai/agents/{{.ID}}" class="chip">開く</a></td>
        </tr>{{else}}<tr><td colspan="7" class="empty">まだエージェント実行がありません</td></tr>{{end}}
      </tbody>
    </table>
  </div>
</section>{{end}}
