{{define "content"}}<section class="sessions">
  <div class="sessions__header">
    <h1>セッション</h1>
    <button type="button" id="new-session-trigger" class="btn" aria-haspopup="dialog" aria-controls="session-modal">新しいセッション</button>
  </div>
  {{template "undo_delete" .}}
  {{/* One line per session, expanding. 目的 and the teaching profile
       are what you open a session to check, not what you scroll past to
       find one — and the profile was not on this page at all before, so
       two 「日記」 sessions with different teacher modes were
       indistinguishable without opening each in turn.

       削除 moves one disclosure deep with it: it is destructive, and it
       does not belong beside every row of a list you are scrolling with
       a thumb. */}}
  <ul class="list list--card">
    {{range .Sessions}}
    {{/* data-session-id is the row's stable identity; the title is a
         link and wraps, so reading it out of the markup is parsing
         presentation. */}}
    <li class="list__item" data-session-id="{{.ID}}">
      <details>
        <summary class="list__line">
          <span class="list__primary"><a href="/sessions/{{.ID}}">{{.Title}}</a></span>
          {{if .Purpose}}<span class="badge badge--type">{{.Purpose}}</span>{{end}}
          <span class="list__meta" title="最終更新">{{.Updated}}</span>
        </summary>
        <div class="list__detail">
          {{/* The profile decides how the tutor behaves here. A session
               created before one of these fields existed simply omits
               it rather than printing a blank label. */}}
          <p>
            {{if .TeacherMode}}<span class="chip">{{.TeacherMode}}</span>{{end}}
            {{if .Strictness}}<span class="chip">{{.Strictness}}</span>{{end}}
            {{if .ExplanationLanguage}}<span class="chip">説明 {{.ExplanationLanguage}}</span>{{end}}
            {{if .FeedbackTiming}}<span class="chip">訂正 {{.FeedbackTiming}}</span>{{end}}
          </p>
          <p>作成 {{.Created}}</p>
          <button type="button" class="btn btn--danger btn--sm no-print"
                  data-confirm-delete="{{.DeleteAction}}" data-confirm-delete-label="{{.Title}}"
                  aria-haspopup="dialog" aria-controls="confirm-delete-modal">削除</button>
        </div>
      </details>
    </li>
    {{else}}
    <li class="list__item list__empty"><p class="empty">セッションがありません</p></li>
    {{end}}
  </ul>

  <dialog id="session-modal" class="modal" aria-labelledby="session-modal-title"{{if .FormError}} data-reopen{{end}}>
    <div class="modal__panel">
      <div class="modal__header">
        <h2 id="session-modal-title">新規セッション</h2>
        <button type="button" class="modal__close" data-modal-close aria-label="閉じる"><span aria-hidden="true">&times;</span></button>
      </div>
      {{if .FormError}}<p class="error" role="alert">{{.FormError}}</p>{{end}}
      <form method="post" action="/sessions" class="session-form">
        <label class="field">タイトル
          <input class="input" type="text" name="title" required autofocus value="{{.FormValues.Title}}">
        </label>
        <label class="field">目的
          <select class="select" name="purpose">
            <option value="Blog post"{{if eq .FormValues.Purpose "Blog post"}} selected{{end}}>Blog post</option>
            <option value="Message to friend"{{if eq .FormValues.Purpose "Message to friend"}} selected{{end}}>Message to friend</option>
            <option value="Diary"{{if eq .FormValues.Purpose "Diary"}} selected{{end}}>Diary</option>
            <option value="Formal email"{{if eq .FormValues.Purpose "Formal email"}} selected{{end}}>Formal email</option>
            <option value="Casual conversation practice"{{if eq .FormValues.Purpose "Casual conversation practice"}} selected{{end}}>Casual conversation practice</option>
            <option value="Business Japanese"{{if eq .FormValues.Purpose "Business Japanese"}} selected{{end}}>Business Japanese</option>
            <option value="Creative writing"{{if eq .FormValues.Purpose "Creative writing"}} selected{{end}}>Creative writing</option>
            <option value="JLPT practice"{{if eq .FormValues.Purpose "JLPT practice"}} selected{{end}}>JLPT practice</option>
            <option value="Tutor preparation"{{if eq .FormValues.Purpose "Tutor preparation"}} selected{{end}}>Tutor preparation</option>
          </select>
        </label>
        <label class="field">Teacher mode
          <select class="select" name="teacher_mode">
            <option value="teacher"{{if eq .FormValues.TeacherMode "teacher"}} selected{{end}}>teacher</option>
            <option value="strict-corrector"{{if eq .FormValues.TeacherMode "strict-corrector"}} selected{{end}}>strict-corrector</option>
            <option value="naturalness-coach"{{if eq .FormValues.TeacherMode "naturalness-coach"}} selected{{end}}>naturalness-coach</option>
            <option value="socratic"{{if eq .FormValues.TeacherMode "socratic"}} selected{{end}}>socratic</option>
          </select>
        </label>
        <label class="field">Explanation language
          <select class="select" name="explanation_language">
            <option value="ja"{{if eq .FormValues.ExplanationLanguage "ja"}} selected{{end}}>ja</option>
            <option value="en"{{if eq .FormValues.ExplanationLanguage "en"}} selected{{end}}>en</option>
            <option value="both"{{if eq .FormValues.ExplanationLanguage "both"}} selected{{end}}>both</option>
          </select>
        </label>
        <label class="field">Strictness
          <select class="select" name="strictness">
            <option value="lenient"{{if eq .FormValues.Strictness "lenient"}} selected{{end}}>lenient</option>
            <option value="balanced"{{if eq .FormValues.Strictness "balanced"}} selected{{end}}>balanced</option>
            <option value="strict"{{if eq .FormValues.Strictness "strict"}} selected{{end}}>strict</option>
          </select>
        </label>
        <label class="field">会話の訂正タイミング
          <select class="select" name="feedback_timing">
            <option value="end"{{if eq .FormValues.FeedbackTiming "end"}} selected{{end}}>end — 会話の最後にまとめて表示（会話が途切れません）</option>
            <option value="delayed"{{if eq .FormValues.FeedbackTiming "delayed"}} selected{{end}}>delayed — 数ターンごとにまとめて表示</option>
            <option value="immediate"{{if eq .FormValues.FeedbackTiming "immediate"}} selected{{end}}>immediate — 発言ごとにすぐ表示</option>
          </select>
          <span class="hint">おすすめは「end」です。対話中に訂正が割り込まないよう、デフォルトになっています。</span>
        </label>
        <button type="submit" class="btn">作成</button>
      </form>
    </div>
  </dialog>

  {{template "confirm_delete" .}}
</section>{{end}}
