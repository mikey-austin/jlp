{{define "content"}}<section class="dashboard">
  <h1>ホーム</h1>

  <div class="stat-grid">
    <div class="stat"><span class="stat__value">{{.Stats.RunesWritten}}</span><span class="stat__label">書いた文字数</span></div>
    <div class="stat"><span class="stat__value">{{.Stats.SessionCount}}</span><span class="stat__label">セッション</span></div>
    <div class="stat"><span class="stat__value">{{.Stats.FeedbackRequests}}</span><span class="stat__label">フィードバック</span></div>
    <div class="stat"><span class="stat__value">{{percent .Stats.AcceptanceRate}}%</span><span class="stat__label">納得率</span></div>
    <div class="stat"><span class="stat__value">{{printf "%.1f" .Stats.CorrectionsPer1000}}</span><span class="stat__label">修正/1000字</span></div>
  </div>

  <div class="dashboard-columns">
    <section>
      <h2>よくある間違い</h2>
      <ul class="error-types">
        {{range .Stats.TopErrorTypes}}<li><span class="badge badge--type">{{.Type}}</span><span class="error-count">{{.Count}}</span></li>{{else}}<li class="empty">まだデータがありません</li>{{end}}
      </ul>
    </section>
    <section>
      <h2>最近のセッション</h2>
      <ul class="recent-sessions">
        {{range .RecentSessions}}<li><a href="/sessions/{{.ID}}">{{.Title}}</a></li>{{else}}<li class="empty">セッションがありません</li>{{end}}
      </ul>
    </section>
  </div>

  <h2>語彙ファネル</h2>
  <div class="funnel">
    <div class="funnel__stage"><span class="funnel__value">{{.Funnel.LookedUp}}</span><span class="funnel__label">調べた</span></div>
    <span class="funnel__arrow" aria-hidden="true">→</span>
    <div class="funnel__stage"><span class="funnel__value">{{.Funnel.Produced}}</span><span class="funnel__label">使った</span></div>
    <span class="funnel__arrow" aria-hidden="true">→</span>
    <div class="funnel__stage"><span class="funnel__value">{{.Funnel.ProducedCorrectly}}</span><span class="funnel__label">正しく使えた</span></div>
  </div>

  <h2>弱点トレンド</h2>
  <ul class="weakness-trends">
    {{range .WeaknessTrends}}<li>
      <span class="weakness-trends__subject">{{.Subject}}</span>
      {{template "sparkline" .}}
    </li>{{else}}<li class="empty">弱点が見つかりません</li>{{end}}
  </ul>

  <h2>自信の較正</h2>
  <div class="table-card">
    <table>
      <thead><tr><th>自信</th><th>試行数</th><th>正答率</th></tr></thead>
      <tbody>
        {{range .Calibration}}<tr>
          <td>{{.Confidence}}</td>
          <td>{{.Attempts}}</td>
          <td>{{percent .CorrectRate}}%</td>
        </tr>{{else}}<tr><td colspan="3" class="empty">自信を記録した試行がありません</td></tr>{{end}}
      </tbody>
    </table>
  </div>
</section>{{end}}
