{{define "content"}}<section class="vocabulary">
  <h1>語彙</h1>
  <nav class="filter-tabs">
    <a href="/vocabulary"{{if eq .Filter ""}} class="is-active"{{end}}>すべて</a>
    <a href="/vocabulary?filter=looked-up"{{if eq .Filter "looked-up"}} class="is-active"{{end}}>調べた</a>
    <a href="/vocabulary?filter=produced"{{if eq .Filter "produced"}} class="is-active"{{end}}>使えた</a>
    <a href="/vocabulary?filter=activate"{{if eq .Filter "activate"}} class="is-active"{{end}}>活性化候補</a>
  </nav>
  {{template "undo_delete" .}}

  {{/* One line per word, expanding — the same treatment 学習 got, and
       for the same reason. Nine columns needed roughly four screens of
       horizontal swipe at 390px, and the stacked-card fallback that
       rescued them turned every word into a nine-line block: five
       hundred words became five hundred blocks.

       What stays on the line is what you scan FOR — the word itself,
       with its reading above it, what kind it is, and how much you have
       used it. Meaning, gloss, tags and source are what you open a word
       to read, not what you scroll past to find one.

       <details> per row: no JavaScript, and keyboard and screen-reader
       behaviour come with it. */}}
  <ul class="word-list">
    {{range .Items}}
    {{/* data-expression is the row's stable identity: the visible text
         is wrapped in <ruby> and carries <rp> fallbacks, so anything
         reading the word out of the markup would be parsing presentation.
         Twice now a test has keyed on presentation here and silently
         stopped matching. */}}
    <li class="word" data-expression="{{.Expression}}">
      <details>
        <summary class="word__line">
          <span class="word__expression" lang="ja">{{template "ruby" .Ruby}}</span>
          <span class="badge badge--type">{{.KindLabel}}</span>
          {{/* Use before lookups: "have I produced this" is the question
               the whole vocabulary funnel is about, and a word looked up
               nine times and never used is exactly what 活性化候補
               exists to surface. */}}
          <span class="word__use" title="使えた回数 / 調べた回数">✓{{.SuccessfulProductions}}<span class="word__sep">/</span>{{.Lookups}}</span>
        </summary>
        {{if .HasDetail}}
        <div class="word__detail">
          {{if .Meaning}}<p class="word__meaning" lang="ja">{{.Meaning}}{{template "speak" .Meaning}}</p>{{end}}
          {{if .MeaningEN}}<p class="word__en">{{.MeaningEN}}</p>{{end}}
          <p class="word__counts">
            調べた {{.Lookups}}回 ・ 使えた {{.SuccessfulProductions}}回{{if .FailedProductions}} ・ 誤用 {{.FailedProductions}}回{{end}}
          </p>
          {{if .TagsJoined}}<p class="word__tags">{{.TagsJoined}}</p>{{end}}
          {{if .Source}}<p class="word__source">{{.Source}}</p>{{end}}
          {{/* Destructive, so it lives one disclosure deep rather than
               beside every word in a list you are scrolling with a
               thumb. */}}
          <button type="button" class="btn btn--danger btn--sm no-print"
                  data-confirm-delete="{{.DeleteAction}}" data-confirm-delete-label="{{.Expression}}"
                  aria-haspopup="dialog" aria-controls="confirm-delete-modal">削除</button>
        </div>
        {{end}}
      </details>
    </li>
    {{else}}
    <li class="word word--empty"><p class="empty">語彙がありません</p></li>
    {{end}}
  </ul>

  {{/* Forward-only, because the cursor is a keyset: see migration
       00028. "最初に戻る" appears only past page one, so page one shows a
       single control rather than two, one of which points at itself. */}}
  {{if or .NextPage (not .OnFirstPage)}}
  <nav class="pagination" aria-label="ページ送り">
    {{if not .OnFirstPage}}<a class="btn btn--secondary btn--sm" href="{{.FirstPage}}">最初に戻る</a>{{end}}
    {{if .NextPage}}<a class="btn btn--secondary btn--sm" href="{{.NextPage}}" rel="next">次の{{.PageSize}}件 →</a>{{end}}
  </nav>
  {{end}}

  {{template "confirm_delete" .}}
</section>{{end}}
