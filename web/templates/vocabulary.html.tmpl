{{define "content"}}<section class="vocabulary">
  <h1>語彙</h1>
  <nav class="filter-tabs">
    <a href="/vocabulary"{{if eq .Filter ""}} class="active"{{end}}>すべて</a>
    <a href="/vocabulary?filter=looked-up"{{if eq .Filter "looked-up"}} class="active"{{end}}>調べた</a>
    <a href="/vocabulary?filter=produced"{{if eq .Filter "produced"}} class="active"{{end}}>使えた</a>
    <a href="/vocabulary?filter=activate"{{if eq .Filter "activate"}} class="active"{{end}}>活性化候補</a>
  </nav>
  <table class="sessions-table vocabulary-table">
    <thead><tr><th>表現</th><th>読み方</th><th>意味</th><th>種類</th><th>検索回数</th><th>使用</th></tr></thead>
    <tbody>
      {{range .Items}}<tr>
        <td>{{.Expression}}</td>
        <td>{{.Reading}}</td>
        <td>{{.Meaning}}</td>
        <td>{{.KindLabel}}</td>
        <td>{{.Lookups}}</td>
        <td>✓{{.SuccessfulProductions}} ✗{{.FailedProductions}}</td>
      </tr>{{else}}<tr><td colspan="6">語彙がありません</td></tr>{{end}}
    </tbody>
  </table>
</section>{{end}}
