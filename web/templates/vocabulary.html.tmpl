{{define "content"}}<section class="vocabulary">
  <h1>語彙</h1>
  <nav class="filter-tabs">
    <a href="/vocabulary"{{if eq .Filter ""}} class="is-active"{{end}}>すべて</a>
    <a href="/vocabulary?filter=looked-up"{{if eq .Filter "looked-up"}} class="is-active"{{end}}>調べた</a>
    <a href="/vocabulary?filter=produced"{{if eq .Filter "produced"}} class="is-active"{{end}}>使えた</a>
    <a href="/vocabulary?filter=activate"{{if eq .Filter "activate"}} class="is-active"{{end}}>活性化候補</a>
  </nav>
  {{template "undo_delete" .}}
  <div class="table-card table-card--stack">
    <table>
      <thead><tr><th>表現</th><th>読み方</th><th>意味</th><th>English</th><th>タグ</th><th>種類</th><th>検索回数</th><th>使用</th><th></th></tr></thead>
      <tbody>
        {{range .Items}}<tr>
          <td data-label="表現">{{.Expression}}</td>
          <td data-label="読み方">{{.Reading}}</td>
          <td data-label="意味">{{.Meaning}}</td>
          <td data-label="English">{{if .MeaningEN}}{{.MeaningEN}}{{end}}</td>
          <td data-label="タグ">{{if .TagsJoined}}{{.TagsJoined}}{{end}}</td>
          <td data-label="種類"><span class="badge badge--type">{{.KindLabel}}</span></td>
          <td data-label="検索回数">{{.Lookups}}</td>
          <td data-label="使用">✓{{.SuccessfulProductions}} ✗{{.FailedProductions}}</td>
          <td data-label="操作"><button type="button" class="btn btn--danger btn--sm no-print" data-confirm-delete="{{.DeleteAction}}" data-confirm-delete-label="{{.Expression}}" aria-haspopup="dialog" aria-controls="confirm-delete-modal">削除</button></td>
        </tr>{{else}}<tr><td colspan="9" class="empty">語彙がありません</td></tr>{{end}}
      </tbody>
    </table>
  </div>

  {{template "confirm_delete" .}}
</section>{{end}}
