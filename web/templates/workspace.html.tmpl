{{define "content"}}<div class="workspace">
  <div class="workspace__main">
    <section id="editor-pane" class="card">
      <textarea id="editor" lang="ja" spellcheck="false" data-doc-id="{{.Document.ID}}"
                placeholder="ここに日本語で書いてください…">{{.Document.Content}}</textarea>
      <div class="editor-status"><span id="save-state" data-state="saved">保存済み</span>
           <span id="rune-count">{{.Document.RuneCount}}</span>字</div>
    </section>
    <section id="feedback-pane" class="card">
      <div class="feedback-trigger">
        <button id="feedback-btn" class="btn" hx-post="/sessions/{{.Session.ID}}/feedback"
                hx-target="#feedback-results" hx-swap="innerHTML"
                hx-vals="js:{...window.jlp.selectionPayload()}">
          フィードバックを取得</button>
        <span class="hint">（選択なし＝全文をレビュー）</span>
      </div>
      <div id="feedback-results"></div>
    </section>
    <section id="conversation-pane" class="card">
      <h2>会話練習</h2>
      <p class="hint">{{.FeedbackTimingCopy}}</p>
      <div id="conversation-transcript">{{range .ConversationTurns}}{{template "conversation_turn" .}}{{end}}</div>
      <form id="conversation-form" class="conv-form" hx-post="/sessions/{{.Session.ID}}/conversation"
            hx-target="#conversation-transcript" hx-swap="beforeend"
            hx-on::after-request="if(event.detail.successful) this.reset()">
        <input class="input" type="text" name="text" placeholder="日本語でメッセージを送ってください…" required autocomplete="off">
        <button type="submit" class="btn btn--sm">送信</button>
      </form>
      <form hx-post="/sessions/{{.Session.ID}}/conversation/summary" hx-target="#conversation-digest" hx-swap="innerHTML">
        <button type="submit" class="btn btn--secondary btn--sm">会話をまとめる</button>
      </form>
      <div id="conversation-digest"></div>
    </section>
  </div>
  <aside id="context-pane" class="card">
    <h2>{{.Session.Title}}</h2>
    <dl class="context-fields">
      <dt>目的</dt><dd>{{.Session.Purpose}}</dd>
      <dt>Teacher mode</dt><dd>{{.Session.Profile.TeacherMode}}</dd>
      <dt>Explanation language</dt><dd>{{.Session.Profile.ExplanationLanguage}}</dd>
      <dt>Strictness</dt><dd>{{.Session.Profile.Strictness}}</dd>
      {{if .Session.Profile.Audience}}<dt>Audience</dt><dd>{{.Session.Profile.Audience}}</dd>{{end}}
      {{if .Session.Profile.Tone}}<dt>Tone</dt><dd>{{.Session.Profile.Tone}}</dd>{{end}}
      {{if .Session.Profile.Register}}<dt>Register</dt><dd>{{.Session.Profile.Register}}</dd>{{end}}
    </dl>
    <h3>アクティビティ</h3>
    <div id="activity" hx-get="/sessions/{{.Session.ID}}/activity" hx-trigger="load, every 30s"></div>
  </aside>
</div>
{{end}}
