{{define "content"}}<section class="lessons">
  <h1>レッスン</h1>
  <form method="post" action="/lessons" class="no-print">
    <button type="submit" class="btn">レッスンガイド作成</button>
  </form>

  {{template "undo_delete" .}}
  <div class="table-card">
    <table>
      <thead><tr><th>作成日</th><th>状態</th><th></th></tr></thead>
      <tbody>
        {{range .Lessons}}<tr>
          <td>{{.CreatedAt.Format "2006-01-02 15:04"}}</td>
          <td><span class="badge">{{.Status}}</span></td>
          <td><a href="/lessons/{{.ID}}" class="chip">開く</a>
              <button type="button" class="btn btn--danger btn--sm no-print" data-confirm-delete="/lessons/{{.ID}}/delete" data-confirm-delete-label="{{.CreatedAt.Format "2006-01-02 15:04"}} のレッスンガイド" aria-haspopup="dialog" aria-controls="confirm-delete-modal">削除</button></td>
        </tr>{{else}}<tr><td colspan="3" class="empty">レッスンガイドがありません。上のボタンから作成できます。</td></tr>{{end}}
      </tbody>
    </table>
  </div>

  {{template "confirm_delete" .}}
</section>{{end}}
