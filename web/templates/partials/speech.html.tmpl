{{/* Phase 4 Task 8 (PRD §66): the record button + status line for the
     conversation pane's speech-to-text control, factored into its own
     partial the same way conversation_turn/correction_card are —
     web/templates/workspace.html.tmpl includes it right after
     #conversation-form (speech_record is rendered INSIDE that form,
     which is what lets #speech-event-id below submit alongside it).
     No template data of its own beyond .Session.ID: record.js (via
     the #record-btn/#record-status/#speech-event-id ids — JS hooks
     only, never styling hooks, per this codebase's design system
     convention) does all the wiring; data-transcribe-url points it at
     POST /speech/transcribe without hardcoding the route a second
     time in JS. data-session-id is threaded into that POST's
     "session_id" field so the recorded speech.transcribed event
     carries a real session (code review Important I1) instead of
     always being session-less. */}}
{{define "speech_record"}}
<button type="button" id="record-btn" class="btn btn--secondary btn--sm"
        data-transcribe-url="/speech/transcribe" data-session-id="{{.Session.ID}}"
        aria-label="音声を録音してテキストに変換">🎙 録音</button>
{{/* Populated by record.js from POST /speech/transcribe's own
     event_id field on a successful transcription, read by
     conversationSay (internal/adapters/http/conversation.go) as
     "speech_event_id" and threaded into appconversation.Service.Say's
     sourceEventID parameter — the join key I1 asked for, tying the
     resulting conversation.turn event back to the exact
     speech.transcribed event that produced its text. #conversation-
     form's own hx-on::after-request reset() clears this back to empty
     after every submit, so a later TYPED message never accidentally
     carries a stale prior transcription's id. */}}
<input type="hidden" name="speech_event_id" id="speech-event-id" value="">
{{end}}
{{define "speech_status"}}
<p id="record-status" class="hint" aria-live="polite" hidden></p>
{{end}}
