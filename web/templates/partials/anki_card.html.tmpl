{{define "anki_card"}}
{{/* A flashcard, shown as one: the prompt, then what it turns into.
     Front and back used to be two paragraphs of different greys with
     nothing saying which was which. */}}
<article class="anki-card card" id="anki-{{.ID}}" data-status="{{.Status}}">
  <header class="anki-card__head">
    {{if .SourceLabel}}<span class="badge badge--type">{{.SourceLabel}}</span>{{end}}
    <span class="anki-card__date">{{.Created}}</span>
  </header>
  <p class="front" lang="ja">{{.Front}}</p>
  <p class="back" lang="ja">{{.Back}}{{template "speak" .Back}}</p>
  {{if .Notes}}<p class="notes">{{.Notes}}</p>{{end}}
  {{if eq .Status "draft"}}<footer>
    <button class="btn btn--sm" hx-post="/anki/{{.ID}}/status" hx-vals='{"status":"approved"}'
            hx-target="#anki-{{.ID}}" hx-swap="outerHTML">承認</button>
    <button class="btn btn--secondary btn--sm" hx-post="/anki/{{.ID}}/status" hx-vals='{"status":"rejected"}'
            hx-target="#anki-{{.ID}}" hx-swap="outerHTML">却下</button>
  </footer>
  {{else}}<footer class="resolved">{{.StatusLabel}}</footer>{{end}}
</article>
{{end}}
