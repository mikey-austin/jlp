{{define "feedback"}}
<div class="feedback" data-ai-request="{{.AIRequestID}}" data-feedback-id="{{.ID}}">
  {{/* Phase 4 Task W item 1: which provider/model ACTUALLY served this
       review — not necessarily what was requested (a route can fail
       over — see feedback.Feedback.Provider's doc comment). Both empty
       for a fakeai-backed review outside the observability decorator
       (every test, offline dev), so the badge is omitted entirely
       rather than showing a bare " / ". */}}
  {{if or .Provider .Model}}<p class="feedback-served-by badge badge--type">{{.Provider}} / {{.Model}}</p>{{end}}
  {{if not .Cards}}<p class="all-good">問題は見つかりませんでした。よく書けています！</p>{{else}}
  {{/* HasGatedCard (Phase 2 Task 8): suppress this whole-selection diff
       when any card below is still hiding its own answer behind a
       socratic hint gate — this diff is not itself gated, so showing it
       would print that card's Replacement in the clear. See
       toFeedbackView's doc comment. */}}
  {{if not .HasGatedCard}}
  <section class="diff-block card card--tight">
    <h3>修正案</h3>
    <p class="inline-diff">{{range .DiffSpans}}<span class="{{.Class}}">{{.Text}}</span>{{end}}</p>
  </section>
  {{end}}
  <div class="cards">{{range .Cards}}{{template "correction_card" .}}{{end}}</div>
  {{end}}
  {{if .AIRequestID}}
  <div class="rating" x-data="{ score: 0 }">
    <span>この添削はどうでしたか？</span>
    {{/* 5 buttons; posts on click */}}
    <template x-for="n in 5"><button type="button" class="star"
       :class="{ on: n <= score }"
       @click="score = n; fetch('/ratings', {method:'POST',
          body: new URLSearchParams({ai_request_id: '{{.AIRequestID}}', rating: n})})">★</button></template>
  </div>
  {{end}}
</div>
{{end}}
