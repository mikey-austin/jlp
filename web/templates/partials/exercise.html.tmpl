{{define "exercise"}}
<div class="exercise card" id="exercise-{{.ID}}" data-exercise-id="{{.ID}}" data-type="{{.Type}}">
  <p class="instructions ja">{{.InstructionsJA}}</p>
  <p class="instructions en">{{.InstructionsEN}}</p>
  <p class="prompt">{{.Prompt}}</p>
  <form class="exercise-form" hx-post="/practice/{{.ID}}/answer" hx-target="#exercise-area" hx-swap="innerHTML">
    {{if eq .Type "multiple-choice"}}
    <div class="choices">
      {{range .Choices}}<label class="choice"><input type="radio" name="response" value="{{.}}" required> {{.}}</label>{{end}}
    </div>
    {{else if eq .Type "free-production"}}
    <textarea class="textarea" name="response" rows="4" required></textarea>
    {{else}}
    <input class="input" type="text" name="response" required autocomplete="off">
    {{end}}
    <label class="field confidence-select">自信度（任意）
      <select class="select" name="confidence">
        <option value="0">—</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
      </select>
    </label>
    <button type="submit" class="btn">送信</button>
  </form>
</div>
{{end}}

{{define "exercise_result"}}
<div class="exercise-result card" data-correct="{{.Correct}}">
  {{if .Correct}}<p class="result-banner correct">正解！</p>{{else}}<p class="result-banner retry">もう一度挑戦しましょう。</p>{{end}}
  <p class="feedback ja">{{.FeedbackJA}}</p>
  <p class="feedback en">{{.FeedbackEN}}</p>
  <button class="btn" hx-post="/practice/start" hx-target="#exercise-area" hx-swap="innerHTML">次の問題へ</button>
</div>
{{end}}
