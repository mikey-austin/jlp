{{/* speak renders a "say this aloud" button for the text passed in.
     data-speak is read by app.js, which POSTs it to /speech/say. Marked
     aria-hidden-free and given a real label because it is a control, not
     decoration; when TTS is not configured the button reports
     unavailable on click rather than being absent, so the learner learns
     the capability exists and is off. */}}
{{define "exercise"}}
<div class="exercise card" id="exercise-{{.ID}}" data-exercise-id="{{.ID}}" data-type="{{.Type}}">
  {{template "run_header" .}}
  <p class="instructions ja">{{.InstructionsJA}}{{template "speak" .InstructionsJA}}</p>
  <p class="instructions en">{{.InstructionsEN}}</p>

  {{if .IsWord}}
  {{/* A flip card, not a form. The reading and meaning are the learner's
       OWN stored vocabulary, so having them in the DOM reveals nothing
       they did not write themselves — unlike a generated exercise's
       Answer, which is never sent to the page.

       <details>, not Alpine: turning a card over is exactly what it
       does, natively and with no JavaScript. An x-show/x-cloak version
       stays permanently shut if Alpine fails to load — the learner could
       never reveal the answer or grade themselves — and this has neither
       failure mode, plus keyboard and screen-reader behaviour for free. */}}
  <div class="flip-card">
    <p class="flip-card__front" lang="ja">{{.Prompt}}{{template "speak" .Prompt}}</p>
    <details class="flip-card__reveal">
      <summary class="btn btn--ghost">めくる</summary>
      <div class="flip-card__back">
      {{if .Reading}}<p class="flip-card__reading" lang="ja">{{.Reading}}{{template "speak" .Reading}}</p>{{end}}
      {{if .Meaning}}<p class="flip-card__meaning">{{.Meaning}}{{template "speak" .Meaning}}</p>{{end}}
      {{/* The sentence the learner met this word in, with the word
           itself emphasised — the context is what makes a word stick,
           and it is exactly what a bare flip card throws away. Split
           server-side into before/word/after so all three escape
           normally; see sentenceHighlight. */}}
      {{with .ExampleParts}}
      <p class="flip-card__example" lang="ja">{{.Before}}<strong>{{template "ruby" .Ruby}}</strong>{{.After}}{{template "speak" .Whole}}</p>
      {{end}}
      {{/* Self-graded, because only the learner knows whether they
           recalled it BEFORE turning the card over. Both buttons post
           the same route as a typed answer; the token is what differs. */}}
      <div class="flip-card__grade">
        <form hx-post="/practice/{{.ID}}/answer" hx-target="#exercise-area" hx-swap="innerHTML">
          <input type="hidden" name="response" value="again">
          <input type="hidden" name="position" value="{{.Position}}">
          <input type="hidden" name="run_correct" value="{{.Streak}}">
          <input type="hidden" name="drilled" value="{{.Drilled}}">
          <button type="submit" class="btn btn--ghost">もう一度</button>
        </form>
        <form hx-post="/practice/{{.ID}}/answer" hx-target="#exercise-area" hx-swap="innerHTML">
          <input type="hidden" name="response" value="knew">
          <input type="hidden" name="position" value="{{.Position}}">
          <input type="hidden" name="run_correct" value="{{.Streak}}">
          <input type="hidden" name="drilled" value="{{.Drilled}}">
          <button type="submit" class="btn">できた</button>
        </form>
        </div>
      </div>
    </details>
  </div>
  {{else}}
  {{if .IsPassage}}
  {{/* The passage is something to READ, not the question — the question
       is the instruction above. Rendered as its own block so it does not
       look like a very long prompt. */}}
  <div class="passage" lang="ja">{{.Prompt}}{{template "speak" .Prompt}}</div>
  {{else}}
  <p class="prompt" lang="ja">{{.Prompt}}{{template "speak" .Prompt}}</p>
  {{end}}
  <form class="exercise-form" hx-post="/practice/{{.ID}}/answer" hx-target="#exercise-area" hx-swap="innerHTML">
    {{/* The run travels with the exchange rather than living on the
         server — see exerciseView's own comment. */}}
    <input type="hidden" name="position" value="{{.Position}}">
    <input type="hidden" name="run_correct" value="{{.Streak}}">
    {{/* Driven by whether there ARE choices, not by type. A cloze has
         them when the learner has enough vocabulary to build distractors
         from and is typed otherwise, and keying on the type would mean
         listing every type that might have them and forgetting one. */}}
    {{if .Choices}}
    <div class="choices">
      {{range .Choices}}<label class="choice"><input type="radio" name="response" value="{{.}}" required> {{.}}</label>{{end}}
    </div>
    {{else if eq .Type "free-production"}}
    <textarea class="textarea" name="response" rows="4" required></textarea>
    {{else}}
    {{/* data-live-check is the expected answer, and is present ONLY for
         a cloze over the learner's own vocabulary — a word they wrote
         down themselves, whose flip-card sibling is self-graded anyway.
         A generated exercise's answer never reaches the page. */}}
    <input class="input" type="text" name="response" required autocomplete="off" lang="ja"
           {{if .LiveCheck}}data-live-check="{{.LiveCheck}}" aria-describedby="live-check-hint"{{end}}>
    {{if .LiveCheck}}<p id="live-check-hint" class="live-check" data-state="empty" aria-live="polite"></p>{{end}}
    {{end}}
    <label class="field confidence-select">自信度（任意）
      <select class="select" name="confidence">
        <option value="0">—</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
      </select>
    </label>
    <div class="exercise-actions">
      <button type="submit" class="btn">送信</button>
      {{/* formnovalidate because the answer field is required and this
           submit deliberately carries no answer. Guessing to get past a
           question teaches the scheduler that a coin flip was a recall;
           this says "I don't know" honestly, and the result then shows
           what it was. */}}
      <button type="submit" class="btn btn--ghost" name="not_sure" value="1" formnovalidate>分からない</button>
    </div>
  </form>
  {{end}}
</div>
{{end}}

{{define "exercise_result"}}
<div class="exercise-result card" data-correct="{{.Correct}}">
  {{/* The run's covered words, for window.jlp.practiceVals to read.
       In an attribute rather than interpolated into the hx-vals JS
       expression: a bare id there is a syntax error, hx-vals throws, and
       the button silently does nothing — which is exactly what 次の問題へ
       did. Attribute context is also the only context html/template
       escapes correctly here. */}}
  <span id="run-drilled" data-drilled="{{.Drilled}}" hidden></span>
  {{template "run_header" .}}
  {{/* Three states, not two. "もう一度挑戦しましょう" is the wrong thing
       to say to someone who just told you they did not know — they did
       not miss, they declined, and the useful reply is the answer. */}}
  {{if .Correct}}<p class="result-banner correct">正解！</p>
  {{else if .NotSure}}<p class="result-banner unsure">答えを見てみましょう。</p>
  {{else}}<p class="result-banner retry">もう一度挑戦しましょう。</p>{{end}}

  {{/* The diff shows WHERE it missed instead of only that it did — same
       .d-ins/.d-del the correction card renders, from the same diff. Only
       present when there is one canonical answer that was actually typed
       (never for free production, never for a self-graded card). */}}
  {{if .Spans}}
  <div class="answer-diff">
    <p class="answer-diff__label">正解との違い</p>
    <p class="answer-diff__spans" lang="ja">{{range .Spans}}<span class="{{.Class}}">{{.Text}}</span>{{end}}</p>
    <p class="answer-diff__answer" lang="ja">正解：{{template "ruby" .AnswerRuby}}</p>
  </div>
  {{else if .Answer}}
  {{/* No diff to show — nothing was typed, or nothing was attempted —
       but the answer itself is the whole point of asking. */}}
  <p class="answer-plain" lang="ja">正解：{{template "ruby" .AnswerRuby}}{{template "speak" .Answer}}</p>
  {{end}}

  {{/* Always shown once the answer is in: getting a word right without
       recalling what it means is not knowing the word, and a choice
       question makes that especially easy to do by elimination. */}}
  {{if .Definition}}<p class="answer-definition">{{.Definition}}{{template "speak" .Definition}}</p>{{end}}

  {{/* The sentence restored, with the word emphasised. Shown only now:
       while a cloze is open, this IS the answer. */}}
  {{with .ExampleParts}}
  <p class="answer-example" lang="ja">{{.Before}}<strong>{{template "ruby" .Ruby}}</strong>{{.After}}{{template "speak" .Whole}}</p>
  {{end}}

  <p class="feedback ja">{{.FeedbackJA}}{{template "speak" .FeedbackJA}}</p>
  <p class="feedback en">{{.FeedbackEN}}</p>

  {{if .Done}}
  {{/* The end of a set. Built from the same quiz.answered events the
       review queue and the learner model read, so it cannot disagree
       with the 学習 page it points at. */}}
  <div class="run-summary">
    <h2 class="run-summary__title">{{.Total}}問おつかれさまでした</h2>
    {{with .Summary}}
    <div class="stat-grid">
      <div class="stat"><span class="stat__value">{{.Answered}}</span><span class="stat__label">解答</span></div>
      <div class="stat"><span class="stat__value">{{.Correct}}</span><span class="stat__label">正解</span></div>
      <div class="stat"><span class="stat__value">{{.Accuracy}}%</span><span class="stat__label">正答率</span></div>
    </div>
    {{if .Words}}
    <h3 class="run-summary__heading">語彙</h3>
    <ul class="run-summary__list">
      {{range .Words}}<li class="run-summary__item{{if .Missed}} is-missed{{end}}">
        <span lang="ja">{{.Label}}</span>{{template "speak" .Label}}
        {{if .Missed}}<span class="run-summary__flag">もう一度</span>{{end}}
      </li>{{end}}
    </ul>
    {{end}}
    {{if .Concepts}}
    <h3 class="run-summary__heading">文法</h3>
    <ul class="run-summary__list">
      {{range .Concepts}}<li class="run-summary__item{{if .Missed}} is-missed{{end}}">
        <span>{{.Label}}</span>
        {{if .Missed}}<span class="run-summary__flag">もう一度</span>{{end}}
      </li>{{end}}
    </ul>
    {{end}}
    <p class="run-summary__next">
      間違えたものは<a href="/learner">学習</a>の復習キューに入っています。
    </p>
    {{end}}
  </div>
  <button class="btn" hx-post="/practice/start" hx-target="#exercise-area" hx-swap="innerHTML"
          hx-vals="js:{...window.jlp.practiceVals(), position: 1, run_correct: 0, drilled: ''}"
          data-progress-into="#exercise-area"
          data-progress-label-from="#provider-override"
          data-progress-verb="が問題を作成中">もう一度やる</button>
  {{else}}
  {{/* Reads the SAME #provider-override the page bar owns — it lives
       outside #exercise-area precisely so it survives this swap. */}}
  <button class="btn" hx-post="/practice/start" hx-target="#exercise-area" hx-swap="innerHTML"
          hx-vals="js:{...window.jlp.practiceVals(), position: {{.NextPosition}}, run_correct: {{.Streak}}}"
          data-progress-into="#exercise-area"
          data-progress-label-from="#provider-override"
          data-progress-verb="が問題を作成中">次の問題へ</button>
  {{end}}
</div>
{{end}}
