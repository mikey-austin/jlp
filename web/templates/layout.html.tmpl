{{define "layout"}}<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Pre-paint theme resolution (no FOUC): localStorage("jlp-theme") ->
       prefers-color-scheme -> light. Must run before any stylesheet
       paints; theme.js (loaded later, deferred) only handles the
       toggle from here on. Kept tiny and inline on purpose. -->
  <script>(function(){try{var t=localStorage.getItem("jlp-theme");if(!t){t=(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches)?"dark":"light";}document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","light");}})();</script>
  <title>{{.Title}} — JLP</title>
  <link rel="stylesheet" href="/static/fonts/fonts.css">
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/components.css">
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="manifest" href="/static/manifest.webmanifest">
  <meta name="theme-color" content="oklch(0.565 0.12 162)">
</head>
<body>
  <header class="topbar no-print">
    <a href="/" class="brand"><span class="mark">日</span><strong>JLP</strong></a>
    <nav class="nav no-print" id="topnav">
      <a href="/sessions">セッション</a>
      <a href="/grammar">文法</a>
      <a href="/vocabulary">語彙</a>
      <a href="/practice">練習</a>
      <a href="/anki">Anki</a>
      <a href="/lessons">レッスン</a>
      <a href="/learner">学習</a>
      <a href="/ai">AI</a>
    </nav>
    <div class="topbar__right">
      {{with .Identity}}<span class="who">{{.DisplayName}}</span>{{end}}
      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
        <span aria-hidden="true">🌓</span> Toggle theme
      </button>
      <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="topnav" aria-haspopup="true">
        <span aria-hidden="true" class="nav-toggle__icon">☰</span>
        <span class="nav-toggle__label" id="nav-toggle-label">メニュー</span>
      </button>
    </div>
  </header>
  <main>{{template "content" .}}</main>
  <!-- Nav active-state: highlights the topnav link matching the current
       path. Kept as a tiny inline script (like the pre-paint theme
       script above) rather than a server-side field on every handler's
       data map, so Step 1's "layout nav states" requirement needs no
       Go change at all — every page already renders the same topnav
       partial-in-layout, and this runs once against the live DOM right
       after it's parsed. Root "/" only matches exactly (else it would
       also light up for every other path). Also copies the active
       link's own label onto the collapsed hamburger trigger (mobile
       nav, components.css .nav-toggle) so a phone user can see which
       section they're on without opening the menu — falls back to the
       button's own "メニュー" label when nothing matches (e.g. /offline). -->
  <script>(function(){var p=location.pathname;var label=document.getElementById("nav-toggle-label");document.querySelectorAll("#topnav a").forEach(function(a){var href=a.getAttribute("href");var hit=href==="/"?p==="/":(p===href||p.indexOf(href+"/")===0);if(hit){a.classList.add("is-active");a.setAttribute("aria-current","page");if(label){label.textContent=a.textContent;}}});})();</script>
  <script src="/static/js/htmx.min.js" defer></script>
  <script src="/static/js/alpine.min.js" defer></script>
  <script src="/static/js/theme.js" defer></script>
  <script src="/static/js/app.js" defer></script>
</body>
</html>{{end}}
