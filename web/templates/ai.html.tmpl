{{define "content"}}<section class="ai-requests">
  <h1>AI品質ダッシュボード</h1>
  <p class="description"><a href="/ai/agents" class="chip">エージェント実行トレースを見る</a></p>

  <div class="stat-grid">
    <div class="stat"><span class="stat__value">{{.Summary.TotalRequests}}</span><span class="stat__label">総リクエスト</span></div>
    <div class="stat"><span class="stat__value">{{if .Summary.TotalRequests}}{{percent .Summary.SuccessRate}}%{{else}}—{{end}}</span><span class="stat__label">成功率</span></div>
    <div class="stat"><span class="stat__value">{{if .Summary.AvgRating}}{{printf "%.1f" .Summary.AvgRating}}{{else}}—{{end}}</span><span class="stat__label">平均評価</span></div>
    <div class="stat"><span class="stat__value">{{printf "%.6f" .Summary.TotalCostUSD}}</span><span class="stat__label">総コスト</span></div>
  </div>

  <h2>プロバイダー比較</h2>
  <div class="table-card table-card--stack">
    <table class="ai-table">
      <thead><tr><th>Provider</th><th>Model</th><th>Requests</th><th>Success rate</th><th>Avg rating</th><th>Avg latency (ms)</th><th>P95 latency (ms)</th><th>Total cost (USD)</th></tr></thead>
      <tbody>
        {{range .ProviderStats}}<tr>
          <td data-label="Provider">{{.Provider}}</td>
          <td data-label="Model">{{.Model}}</td>
          <td data-label="Requests">{{.Requests}}</td>
          <td data-label="Success rate">{{percent .SuccessRate}}%</td>
          <td data-label="Avg rating">{{if .AvgRating}}{{printf "%.1f" .AvgRating}}{{else}}—{{end}}</td>
          <td data-label="Avg latency (ms)">{{.AvgLatencyMS}}</td>
          <td data-label="P95 latency (ms)">{{.P95LatencyMS}}</td>
          <td data-label="Total cost (USD)">{{printf "%.6f" .TotalCostUSD}}</td>
        </tr>{{else}}<tr><td colspan="8" class="empty">まだAIリクエストがありません</td></tr>{{end}}
      </tbody>
    </table>
  </div>

  <h2>プロンプト品質</h2>
  <div class="table-card table-card--stack">
    <table class="ai-table">
      <thead><tr><th>Prompt</th><th>Version</th><th>Requests</th><th>Avg rating</th><th>Success rate</th></tr></thead>
      <tbody>
        {{range .PromptStats}}<tr>
          <td data-label="Prompt">{{.PromptName}}</td>
          <td data-label="Version">{{.PromptVersion}}</td>
          <td data-label="Requests">{{.Requests}}</td>
          <td data-label="Avg rating">{{if .AvgRating}}{{printf "%.1f" .AvgRating}}{{else}}—{{end}}</td>
          <td data-label="Success rate">{{percent .SuccessRate}}%</td>
        </tr>{{else}}<tr><td colspan="5" class="empty">まだAIリクエストがありません</td></tr>{{end}}
      </tbody>
    </table>
  </div>

  <h2>最近のリクエスト</h2>
  <div class="table-card table-card--stack">
    <table class="ai-table">
      <thead><tr><th>Provider</th><th>Model</th><th>Prompt</th><th>Latency (ms)</th><th>Tokens in/out</th><th>Cost (USD)</th><th>Success</th><th>Rating</th></tr></thead>
      <tbody>
        {{range .Requests}}<tr>
          <td data-label="Provider">{{.Provider}}</td>
          <td data-label="Model">{{.Model}}</td>
          <td data-label="Prompt">{{.PromptName}} {{.PromptVersion}}</td>
          <td data-label="Latency (ms)">{{.LatencyMS}}</td>
          <td data-label="Tokens in/out">{{.InputTokens}}/{{.OutputTokens}}</td>
          <td data-label="Cost (USD)">{{printf "%.6f" .CostUSD}}</td>
          <td data-label="Success">{{if .Success}}✓{{else}}✗{{end}}</td>
          <td data-label="Rating">{{if .Rating}}{{.Rating}}{{else}}—{{end}}</td>
        </tr>{{else}}<tr><td colspan="8" class="empty">まだAIリクエストがありません</td></tr>{{end}}
      </tbody>
    </table>
  </div>
</section>{{end}}
