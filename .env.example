# Copy to .env (make init). Never commit .env.
ANTHROPIC_API_KEY=            # required only when APP_AI_PROVIDER=anthropic; wired to APP_AI_ANTHROPIC_APIKEY (docker-compose.yml). Ignored (and never called) by APP_AI_PROVIDER=fake or by `make test`, which always uses the fake provider.
APP_AI_PROVIDER=fake          # fake | anthropic | ollama
APP_AI_ANTHROPIC_MODEL=       # optional override; defaults to claude-sonnet-5 when unset/empty (docker-compose.yml passes this through)
APP_AI_ANTHROPIC_BASEURL=     # optional override; defaults to https://api.anthropic.com when unset/empty (docker-compose.yml passes this through)
APP_AI_OLLAMA_URL=            # optional override; defaults to http://ollama:11434 when unset/empty (the compose "ollama" profile's in-network address)
APP_AI_OLLAMA_MODEL=          # required when APP_AI_PROVIDER=ollama, or when a route below sends any prompt to ollama; see `make ollama-pull`
                              # prefer a gemma4 model: thinking is always disabled for speed, and qwen3.6 ignores the JSON schema when it is (see README)
APP_AI_OLLAMA_TIMEOUT=        # optional; bounds one /api/chat round trip (default 5m)
APP_AI_ROUTES=                # optional per-prompt overrides, e.g. "teacher.feedback=ollama,anthropic" — see README's AI providers section
APP_AI_AGENTICTEACHER=false   # opt-in (PRD §27/§50): true drives feedback requests through a tool-calling investigation (/ai/agents trace viewer) before producing corrections, instead of the default single-shot structured-generation path. Leave false/unset for Phase 1's original behaviour and cost, unchanged.
APP_AI_CLAUDECLI_BIN=         # optional override; defaults to "claude" when unset/empty. Host-mode only (PRD §23) — the compose containers don't ship the Claude Code CLI, so this only does anything running `go run ./cmd/jlp` directly on a host that has `claude` installed; see README's AI providers section
APP_AI_CODEXCLI_BIN=          # optional override; defaults to "codex" when unset/empty. Same host-mode-only caveat as APP_AI_CLAUDECLI_BIN above
APP_ANKI_CONNECT_URL=         # optional; e.g. http://localhost:8765. Empty (default) keeps the /anki page's AnkiConnect push dormant — TSV export always works with no configuration at all. Only meaningful when the JLP server and a running Anki+AnkiConnect instance share a network path (typically: both on your own machine in dev), which is why this isn't wired into deploy/compose.prod.yml.
APP_AUTH_MODE=static          # static | authelia
AUTHELIA_DEV_PASSWORD=devpassword
DEPLOY_HOST=                  # user@host for make deploy
APP_HOST_PORT=8080             # host port for the dev app (container always listens on 8080)
APP_SUMMARY_ENABLED=false     # opt-in (PRD §65): true starts the weekly-summary cron scheduler in `make up`'s app container. Leave false/unset for a clean boot with zero outbound email capability.
APP_SUMMARY_CRON=              # optional override; defaults to "0 18 * * 0" (Sunday 18:00) when unset/empty
APP_SUMMARY_TO=                # required when APP_SUMMARY_ENABLED=true, and for `make send-summary` (jlp send-summary errors without it)
APP_SUMMARY_FROM=               # currently INFORMATIONAL ONLY — has no effect on outbound mail yet; internal/adapters/smtp always sends with a fixed sender (see internal/config.Summary's doc comment)
APP_SMTP_ADDR=                  # optional override; defaults to "mailpit:1025" (the `make up-mail` Mailpit service) when unset/empty
APP_MQTT_URL=                    # optional; e.g. tcp://mosquitto:1883. Empty (default) keeps the MQTT event bridge entirely dormant — no broker connection is ever attempted. `make up-mqtt` sets this for you against the compose "mqtt" profile's mosquitto service; see README's MQTT event bridge section
APP_A2A_ENABLED=false           # opt-in (PRD §29/§30): true mounts the A2A protocol adapter (agent card + task endpoints) inside the authenticated route group. Leave false/unset for its routes to be entirely absent (404); see README's A2A protocol adapter section
APP_A2A_PATH=                    # optional override; defaults to "/a2a" when unset/empty
APP_SLACK_APPTOKEN=              # opt-in (PRD §20/§20.1): Socket Mode app-level token ("xapp-..."). Both this and APP_SLACK_BOTTOKEN empty (default) keeps the Slack adapter entirely dormant — no connection ever dialed. Must be set together with APP_SLACK_BOTTOKEN; see README's Slack channel adapter section
APP_SLACK_BOTTOKEN=              # bot token ("xoxb-..."), required together with APP_SLACK_APPTOKEN above
APP_SLACK_SMOKECHANNEL=          # a Slack channel or user ID; only used by `make slack-smoke` to post one test message
APP_SIGNAL_RPCURL=               # opt-in (PRD §20/§20.1): signal-cli JSON-RPC daemon address, e.g. "signal-cli:6006" (the `make up-signal` "signal" profile's in-network default). Both this and APP_SIGNAL_NUMBER empty (default) keeps the Signal adapter entirely dormant — see README's Signal channel adapter section
APP_SIGNAL_NUMBER=               # the linked account's own E.164 number (e.g. "+15555550100"), required together with APP_SIGNAL_RPCURL above; see `make signal-register` and deploy/signal/README.md for the one-time device-link step
APP_CHANNELS_ALLOWFROM=          # comma list of "<channel>:<external id>=<identity>", e.g. "slack:U0123ABCDEF=dev,signal:+15555550100=dev" — the untrusted-edge allow-list (PRD §20.1): a sender not listed here gets a polite refusal and nothing is recorded. Empty (default) allows nobody.
