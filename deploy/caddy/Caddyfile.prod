{$JLP_DOMAIN}:8444 {
	tls internal

	# /healthz must stay reachable without a session so wait-healthy.sh
	# (and any external uptime check) can probe the app without going
	# through Authelia. `handle` blocks are mutually exclusive in Caddy —
	# a request matching this one never falls through to the block below.
	handle /healthz {
		reverse_proxy app:8080
	}

	handle {
		# Defense in depth: strip any client-supplied Remote-* headers
		# before forward_auth runs, so a spoofed header from an
		# authenticated (or unauthenticated) client can never reach the
		# app, even if copy_headers' overwrite behavior ever changes.
		#
		# This MUST be wrapped in an explicit `route` block: Caddy's
		# default directive order runs forward_auth *before*
		# request_header (verified via `caddy adapt` for the dev
		# Caddyfile), so outside of `route`, these deletes would run
		# after copy_headers has already written the real, trusted
		# values — wiping out the legitimate headers on every request,
		# including authenticated ones. Inside `route`, directives
		# execute in the literal order written, so the strip happens
		# first as intended. See deploy/caddy/Caddyfile.dev and
		# task-5-report.md for the empirical verification of both
		# orderings.
		route {
			request_header -Remote-User
			request_header -Remote-Groups
			request_header -Remote-Name
			request_header -Remote-Email

			forward_auth authelia:9091 {
				uri /api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
			}
			reverse_proxy app:8080
		}
	}
}

auth.{$JLP_DOMAIN}:8444 {
	tls internal
	reverse_proxy authelia:9091
}
