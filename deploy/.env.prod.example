# Copy to deploy/.env.prod (gitignored). Never commit deploy/.env.prod.
#
# JLP_DOMAIN: public hostname Caddy serves and the domain Authelia's
# session cookie/portal URLs are scoped to. No scheme, no port (Caddy
# always listens on :8444). Must contain at least one period — Authelia
# rejects a bare single-label domain like "localhost" outright
# ("option 'domain' is not a valid cookie domain: must have at least a
# single period or be an ip address"). For `make deploy-local`
# verification, "jlp.localhost" works — browsers/OS resolve *.localhost
# to loopback, which covers both this domain and the Authelia portal at
# auth.<domain> (same convention the dev stack uses, see
# deploy/caddy/Caddyfile.dev).
JLP_DOMAIN=jlp.localhost

# Strong password for the prod Postgres instance (e.g. `openssl rand -hex
# 24`). Used to build APP_DATABASE_URL for the app service.
POSTGRES_PASSWORD=

# AI provider for the prod app. fake never calls a real model (safe for
# deploy-local verification, no key needed); anthropic requires
# ANTHROPIC_API_KEY.
APP_AI_PROVIDER=fake
# Required only when APP_AI_PROVIDER=anthropic (a trailing comment on an
# empty value below would otherwise become part of the value itself —
# docker compose's env-file parser doesn't strip "# comment" when there's
# no non-space value before it — so these stay on their own line).
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5 when unset.
APP_AI_ANTHROPIC_MODEL=
# Optional override; defaults to https://api.anthropic.com when unset.
APP_AI_ANTHROPIC_BASEURL=

# `app seed` target identity — NOT used by Authelia login itself (the
# authelia auth adapter trusts Caddy's Remote-User/Remote-Name headers
# only, never these). Set these to match AUTHELIA_PROD_USER/DISPLAYNAME
# below so `docker compose -f deploy/compose.prod.yml --env-file
# deploy/.env.prod run --rm app seed` pre-populates a session belonging to
# whoever you actually log in as.
APP_AUTH_STATIC_ID=admin
APP_AUTH_STATIC_DISPLAYNAME=Admin

# Consumed by scripts/gen-prod-secrets.sh (run once, before `make
# deploy-local` / `make deploy` — not read by compose itself) to generate
# deploy/authelia/users.prod.yml, a single Authelia file-backend user.
# Leave AUTHELIA_PROD_PASSWORD empty to have the script generate and print
# a random password once (only its argon2 hash is ever written to disk).
AUTHELIA_PROD_USER=admin
AUTHELIA_PROD_PASSWORD=
AUTHELIA_PROD_EMAIL=admin@localhost
AUTHELIA_PROD_DISPLAYNAME=Admin
