{{define "content.opf.tmpl"}}<package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="uid" xml:lang="ja">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="uid">{{.UID}}</dc:identifier>
    <dc:title>{{.Title}}</dc:title>
    <dc:language>ja</dc:language>
    <dc:creator>{{if .Source}}{{.Source}}{{else}}JLP{{end}}</dc:creator>
    <dc:publisher>JLP 読解</dc:publisher>
    {{if .SourceURL}}<dc:source>{{.SourceURL}}</dc:source>
    {{end}}<dc:subject>日本語学習</dc:subject>
    <meta property="dcterms:modified">{{.Modified}}</meta>
  </metadata>
  <manifest>
    <item id="nav" href="nav.xhtml" media-type="application/xhtml+xml" properties="nav"/>
    <item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml"/>
    <item id="css" href="style.css" media-type="text/css"/>
    {{range .Chapters}}<item id="{{.ID}}" href="{{.File}}" media-type="application/xhtml+xml"/>
    {{end}}
  </manifest>
  <spine toc="ncx">
    {{range .Chapters}}<itemref idref="{{.ID}}"/>
    {{end}}
  </spine>
</package>
{{end}}
