{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LessonPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level_summary",
    "strengths",
    "weaknesses",
    "focus",
    "vocabulary",
    "grammar_concepts",
    "conversation_prompts",
    "exercises",
    "recent_examples",
    "questions_for_tutor"
  ],
  "properties": {
    "level_summary": { "type": "string", "minLength": 1 },
    "strengths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "weaknesses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "focus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "grammar_concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "conversation_prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "recent_examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "questions_for_tutor": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
